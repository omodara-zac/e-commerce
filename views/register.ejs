<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Create an e-boutique account.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <title>Create an account | e-boutique</title>
</head>
<body class="auth-page">
  <%- include('partials/header') %>
  <main class="auth-layout">
    <section class="auth-intro" aria-labelledby="register-intro-title">
      <span class="auth-eyebrow">E-BOUTIQUE MEMBERS</span>
      <h1 id="register-intro-title">A better way to shop the pieces you love.</h1>
      <p>Create an account for a more personal, seamless e-boutique experience.</p>
      <div class="auth-feature-list" aria-label="Member benefits">
        <div><span aria-hidden="true">01</span> Faster checkout</div>
        <div><span aria-hidden="true">02</span> Your bag, saved</div>
        <div><span aria-hidden="true">03</span> Early access to new pieces</div>
      </div>
    </section>
    <section class="auth-card" aria-labelledby="register-title">
      <div class="auth-card-heading">
        <p class="auth-kicker">JOIN E-BOUTIQUE</p>
        <h2 id="register-title">Create your account</h2>
        <p>It only takes a minute to get started.</p>
      </div>
      <form action="/register" method="POST" class="auth-form">
        <div class="auth-field">
          <label for="register-email">Email address</label>
          <input id="register-email" type="email" name="username" autocomplete="email" placeholder="you@example.com" required>
        </div>
        <div class="auth-field">
          <label for="register-password">Password</label>
          <input id="register-password" type="password" name="password" autocomplete="new-password" placeholder="Create a password" minlength="8" required>
          <small>Use at least 8 characters.</small>
        </div>
        <button type="submit" class="auth-submit">Create account <span aria-hidden="true">→</span></button>
        <% if (typeof errorMessage !== "undefined") { %>
          <p class="auth-error" style="color: red;"><%= errorMessage %></p>
        <% } %>
      </form>
      <div class="auth-divider"><span>or sign up with</span></div>
      <a class="google-button" href="/auth/google"><svg aria-hidden="true" viewBox="0 0 24 24"><path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.24-.2-1.8H12v3.44h5.52c-.11.86-.72 2.16-2.08 3.03l-.02.12 3.03 2.35.21.02c1.92-1.77 2.94-4.38 2.94-7.16Z"/><path fill="#34A853" d="M12 22c2.7 0 4.97-.89 6.63-2.42l-3.16-2.49c-.85.59-1.98 1-3.47 1a5.99 5.99 0 0 1-5.67-4.15l-.11.01-3.15 2.44-.04.11A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.33 13.95A6.09 6.09 0 0 1 6 12c0-.68.12-1.34.32-1.95v-.13L3.14 7.44 3.04 7.5A10 10 0 0 0 2 12c0 1.61.38 3.14 1.04 4.5l3.29-2.55Z"/><path fill="#EA4335" d="M12 6a5.44 5.44 0 0 1 3.85 1.5l2.81-2.74C16.96 3.18 14.7 2 12 2a10 10 0 0 0-8.96 5.5l3.3 2.56A5.98 5.98 0 0 1 12 6Z"/></svg>Continue with Google</a>
      <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
    </section>
  </main>
</body>
</html>
